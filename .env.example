# Stripe secret key — use sk_test_... until live underwriting is approved.
STRIPE_SECRET_KEY=sk_test_xxxx

# Signing secret from Stripe Dashboard webhook endpoint (whsec_...).
# This service's /api/webhook only logs; member access is granted by the
# website's POST /stripe/webhook. You can still set this if you keep the
# backend webhook endpoint registered.
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Public site origin used for default success/cancel/portal return URLs.
CLIENT_URL=https://www.hustleboyzexotic.online

# Set to "true" ONLY after Stripe Dashboard → Settings → Tax has a valid
# head-office address. Leaving this off (default) is required for checkout
# to work today.
STRIPE_AUTOMATIC_TAX=false

PORT=4242
